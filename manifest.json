{
  "manifest_version": 3,
  "name": "Bravely",
  "version": "0.17.1",
  "description": "Pinful's optional companion: image walls and visual-search tools for Google Lens, Pinterest, pixiv and DeviantArt.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://lens.google.com/*"
      ],
      "js": [
        "content.js",
        "pinful-bridge.js"
      ],
      "css": [
        "wall.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.pinterest.com/*"
      ],
      "js": [
        "pinterest-look.js"
      ],
      "css": [
        "pinterest-look.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.pinterest.com/*"
      ],
      "js": [
        "pinterest-pin.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.pinterest.com/*"
      ],
      "js": [
        "pinterest.js"
      ],
      "css": [
        "pinterest.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.deviantart.com/*"
      ],
      "js": [
        "deviantart-images.js",
        "deviantart-look.js"
      ],
      "css": [
        "deviantart-look.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.deviantart.com/*"
      ],
      "js": [
        "deviantart.js"
      ],
      "css": [
        "deviantart.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.pixiv.net/*",
        "https://pixiv.net/*"
      ],
      "js": [
        "pixiv-data.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pixiv.net/*",
        "https://pixiv.net/*"
      ],
      "js": [
        "pixiv-images.js",
        "pixiv-look.js"
      ],
      "css": [
        "pixiv-look.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pixiv.net/*",
        "https://pixiv.net/*"
      ],
      "js": [
        "pixiv.js"
      ],
      "css": [
        "pixiv.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.pinterest.com/*"
      ],
      "js": [
        "pinful-pinterest-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.google.com/*",
    "https://lens.google.com/*",
    "https://*.gstatic.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.pinterest.com/*",
    "https://*.pinimg.com/*",
    "https://*.deviantart.com/*",
    "https://*.wixmp.com/*",
    "https://*.deviantart.net/*",
    "https://www.pixiv.net/*",
    "https://pixiv.net/*",
    "https://*.pximg.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "submit.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "version_name": "0.17.1 development preview",
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/bravely-16.png",
    "32": "icons/bravely-32.png",
    "48": "icons/bravely-48.png",
    "128": "icons/bravely-128.png"
  }
}
